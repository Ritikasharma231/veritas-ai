# VERITAS AI — environment configuration template
# Copy to .env and adjust. Never commit real secrets.

# --- App ---
APP_NAME=VERITAS AI
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# --- Database ---
# SQLite fallback for local dev; set to postgresql+psycopg2://... for Postgres
DATABASE_URL=sqlite:///./veritas.db

# --- Security ---
# Comma-separated API keys for programmatic access (optional)
API_KEYS=
# Max characters accepted for text analysis
MAX_TEXT_LENGTH=50000
# Max article body length fetched from URLs
MAX_FETCH_BYTES=2000000
FETCH_TIMEOUT_SECONDS=15

# --- ML / Model ---
# Path to a locally fine-tuned model directory (produced by ml/training)
# If empty, falls back to MODEL_HF_ID pretrained checkpoint
MODEL_PATH=
MODEL_HF_ID=hamzab/roberta-fake-news-classification
MODEL_MAX_LENGTH=512
# Model labels: comma separated, order must match training
MODEL_LABELS=Fake,Real
# Force CPU even if CUDA is available
FORCE_CPU=false

# --- Rate limiting (requests per minute per IP) ---
RATE_LIMIT_PER_MINUTE=30
